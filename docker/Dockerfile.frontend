# =====================================================================
# 前端镜像：主版前端（Vite 工程构建产物）
# 多阶段：Node 构建 frontend/vite-app → nginx 托管 dist
# 主版源码 = vite-app/index.html(模板) + src/legacy/(app-logic.ts + css)
# /api 由 nginx.conf 反代到网关
# =====================================================================
# syntax=docker/dockerfile:1

FROM node:20-alpine AS build
WORKDIR /build
COPY frontend/vite-app/package.json frontend/vite-app/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/vite-app/ ./
RUN npm run build

FROM nginx:1.27-alpine
ENV TZ=Asia/Shanghai
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist/ /usr/share/nginx/html/
COPY frontend/favicon-*.png /usr/share/nginx/html/
EXPOSE 80
