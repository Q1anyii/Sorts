# =====================================================================
# 梭子 SORTS · 本地编排环境变量（复制为 .env 后按需修改）
#   cp docker/.env.example docker/.env
#   .env 已被 .gitignore 忽略，不会入库
# =====================================================================

# ---------- MySQL（宿主机端口 3307，避开其他项目的 3306） ----------
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=sorts_dev

# ---------- Redis（6379 = redis-stack：Redis + RediSearch 等模块） ----------
# 6380 曾是 WSL 内「原生 redis-server」的端口，密码遗留在 /etc/redis/redis.conf；
# 现统一由容器接管到 6379，原生实例已停用（见 docs/dev-setup.md「中间件」章节）
REDIS_PORT=6379
REDIS_PASSWORD=sorts_dev

# ---------- RabbitMQ（当前代码未使用，为 outbox 技术债预留） ----------
RABBITMQ_PORT=5672
RABBITMQ_CONSOLE_PORT=15672
RABBITMQ_USER=sorts
RABBITMQ_PASSWORD=sorts_dev

# ---------- 后端服务 ----------
GATEWAY_PORT=8080
# 服务间内部凭证：各服务必须一致，否则内部接口 fail-closed
INTERNAL_TOKEN=sorts-internal-dev-token
# AI 服务密钥（留空则 /ai/** 返回 503，服务本身仍可启动）
DEEPSEEK_API_KEY=

# ---------- 前端静态站点（nginx，仅 profiles=web 时启用） ----------
FRONTEND_PORT=8088
# API 基地址：留空 = 同源 /api/v1（由 Nginx 反代 gateway，推荐）。
# 只有前后端分离部署（前端独立域名 / CDN）时才填绝对地址，例如 https://api.example.com/api/v1
VITE_API_BASE=
