<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sorts</groupId>
        <artifactId>sorts-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>sorts-ai</artifactId>
    <name>sorts-ai</name>
    <description>AI 服务：梭灵（DeepSeek 对话、自实现工具集 Tool Calling、规划生成、周期总结）</description>

    <!--
      说明：本模块刻意不引入 Spring AI。
      原因：spring-ai-starter-model-openai:1.0.0 锁定 spring-boot-starter:3.4.5，
            而本项目为 Boot 3.3.4（Cloud 2023.0.3 / SCA 2023.0.3.2 不支持 Boot 3.4），
            且 1.0.0-M5/M6 里程碑版在阿里云镜像上不可用。
      对策：按 OpenAI 兼容协议自实现一个薄客户端（llm 包），藏在 ChatModelClient 接口之后，
            后续若升级到 Boot 3.4+，只需替换该接口的实现，业务代码零改动。
    -->

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 服务注册发现 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- 跨模块调用：OpenFeign（工具集据此读写日程/用户数据，禁止跨库直连） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- ORM：报告与规划持久化 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Redis：多轮对话上下文 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 公共模块 -->
        <dependency>
            <groupId>com.sorts</groupId>
            <artifactId>sorts-common</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>sorts-ai</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
