<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 父 POM：统一依赖版本与构建插件配置 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.sorts</groupId>
    <artifactId>sorts-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>sorts-parent</name>
    <description>梭子 - 智能日程管理平台（主题：光阴似箭，日月如梭）</description>

    <modules>
        <module>sorts-common</module>
        <module>sorts-gateway</module>
        <module>sorts-user</module>
        <module>sorts-schedule</module>
        <module>sorts-ai</module>
        <module>sorts-notification</module>
        <module>sorts-mall</module>
        <!-- 独立指标测试工程（仅测试代码，不产出业务构件） -->
        <module>sorts-metrics-tests</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 版本矩阵：Boot 3.3.x → Cloud 2023.0.x → Cloud Alibaba 2023.0.x（Nacos 2.4.3） -->
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.3.2</spring-cloud-alibaba.version>
        <spring-ai.version>1.0.0</spring-ai.version>

        <!-- 三方组件版本 -->
        <jjwt.version>0.12.6</jjwt.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <redisson.version>3.36.0</redisson.version>
        <hutool.version>5.8.32</hutool.version>
        <knife4j.version>4.5.0</knife4j.version>
        <!-- Testcontainers：真实 DB / Redis 集成测试（mvn -Pintegration test 才跑） -->
        <testcontainers.version>1.20.4</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud 全家桶 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Alibaba（Nacos / Sentinel / Seata） -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 本项目内部公共模块 -->
            <dependency>
                <groupId>com.sorts</groupId>
                <artifactId>sorts-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- MyBatis-Plus：ORM 增强 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- Redisson：分布式锁 / 延迟队列 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <!-- Hutool：轻量工具集 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-core</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <!-- Testcontainers BOM：集成测试用真实中间件，版本由 BOM 统一 -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!--
          集成测试：需要 Docker（真实 MySQL / Redis 容器），因此**默认不跑**，
          避免 `mvn test` 在没有 Docker 的环境里直接失败。

            mvn -Pintegration test          # 跑 *Test 与 *IT
            mvn -Pintegration test -pl sorts-user

          用例本身还标注了 @Testcontainers(disabledWithoutDocker = true)，
          即使带了 profile 但环境没有 Docker，也只是跳过而非失败。
        -->
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*Test.java</include>
                                <include>**/*IT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencies>
        <!-- 健康检查：容器编排（healthcheck / 部署门禁）与被监控都需要 /actuator/health -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 所有模块默认引入测试能力，保证单测随手可写 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  Spring Boot 可执行 Jar 打包（只在实际服务模块启用）。

                  ⚠️ 必须带 classifier，否则会打断 reactor 构建：
                  服务模块同时是「可运行应用」和「下游模块的依赖」——`sorts-metrics-tests`
                  以 test scope 依赖 sorts-ai / sorts-gateway / sorts-mall / sorts-schedule。
                  若不设 classifier，repackage 会**覆盖主产物**，把业务类搬进 BOOT-INF/classes/；
                  一旦构建走到 package 之后（verify / install），reactor 就从已打包的 fat jar
                  解析模块间依赖，下游编译期便找不到 com.sorts.ai.* / com.sorts.mall.* 等包
                  （`mvn test` 只到 test 阶段、依赖取自 target/classes，所以不会暴露）。
                  设了 classifier 后主产物保持为普通 jar，可执行 jar 单独输出为
                  <finalName>-exec.jar —— Dockerfile 用的是后者。
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <classifier>exec</classifier>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
